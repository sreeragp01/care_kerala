# CareLink Kerala — Production Environment Secrets Configuration Template
# IMPORTANT: Copy this template to .env on production servers and populate real secure secrets.

DEBUG=False
ENVIRONMENT=production
SECRET_KEY=prod-ultra-secure-random-secret-key-change-in-production-2026

# Host & Origin Restrictions
ALLOWED_HOSTS=api.carelinkkerala.org,carelinkkerala.org
CORS_ALLOWED_ORIGINS=https://app.carelinkkerala.org,https://carelinkkerala.org

# Database Configuration (Managed PostgreSQL / Supabase)
DB_ENGINE=postgresql
DB_NAME=carelink_prod_db
DB_USER=carelink_prod_user
DB_PASSWORD=YOUR_MANAGED_POSTGRES_PASSWORD_HERE
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DATABASE_URL=postgres://carelink_prod_user:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/carelink_prod_db

# Async Redis Cache & Celery Worker
REDIS_URL=redis://redis-prod.carelink.internal:6379/0

# FCM Notification Credentials
FCM_SERVER_KEY=YOUR_FIREBASE_FCM_SERVER_KEY_HERE
