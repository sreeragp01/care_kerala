# CareLink Kerala Backend Environment Configuration
# Company: Nammal Tech Innovations

DEBUG=1
SECRET_KEY=django-insecure-carelink-kerala-palliative-secret-key-prod
ALLOWED_HOSTS=*

# ==============================================================
# SUPABASE POSTGRESQL DATABASE CONNECTION
#
# IMPORTANT FOR DJANGO & MIGRATIONS:
# Use Port 5432 (Session Pooler Mode or Direct Connection) because
# Django migrations require session-level locking and prepared statements.
# Avoid Port 6543 (Transaction mode) during 'manage.py migrate'.
#
# 1. Direct Connection (Port 5432):
#    DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
#
# 2. Session Pooler Mode (Port 5432):
#    DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# ==============================================================
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# ==============================================================
# Redis & Celery Config (Optional for offline sync workers)
# ==============================================================
REDIS_URL=redis://localhost:6379/0

# ==============================================================
# Google Gemini AI Clinical Triage
# ==============================================================
GEMINI_API_KEY=your_google_gemini_api_key_here

# ==============================================================
# SMS / WhatsApp Notification Gateway
# ==============================================================
SMS_API_KEY=your_sms_gateway_key

# ==============================================================
# Email & SMTP Configuration (Gmail, SendGrid, Amazon SES, Outlook)
# ==============================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_google_app_password
DEFAULT_FROM_EMAIL=CareLink Kerala <noreply@carelink.kerala.gov.in>

