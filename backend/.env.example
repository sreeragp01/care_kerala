# CareLink Kerala Backend Environment Variables

DEBUG=0
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=api.carelinkkerala.org,localhost,127.0.0.1

# Database Config (PostgreSQL)
DATABASE_URL=postgres://carelink_user:carelink_secure_pass@localhost:5432/carelink_db

# Redis & Celery Config
REDIS_URL=redis://localhost:6379/0

# Google Gemini AI Config
GEMINI_API_KEY=your_google_gemini_api_key_here

# SMS / WhatsApp Notification Credentials (Twilio / Gupshup)
SMS_API_KEY=your_sms_gateway_key
